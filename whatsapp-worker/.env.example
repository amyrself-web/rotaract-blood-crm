# From Supabase: Project Settings -> API
SUPABASE_URL=https://bgwkantvhgbxzfkipfda.supabase.co
# The secret (service role) key. Keep this file private: chmod 600 .env
SUPABASE_SERVICE_ROLE_KEY=
# Where the WhatsApp login is kept. Delete this folder to unlink the phone.
AUTH_DIR=./auth

# Which WhatsApp engine to use:
#   baileys (default) - built in, nothing else to install
#   openwa            - an OpenWA gateway on this machine (see docker-compose.openwa.yml)
ENGINE=baileys
# For ENGINE=openwa when OpenWA runs on its own (not with the compose file):
# OPENWA_URL=http://localhost:2785
# OPENWA_API_KEY=
# OPENWA_SESSION=club-crm
# WEBHOOK_PUBLIC_URL=http://host.docker.internal:2790/openwa
